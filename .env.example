# Copiar como .env y reemplazar los valores.
CHATWOOT_WEBHOOK_SECRET=replace-me
CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_ACCOUNT_ID=replace-me
CHATWOOT_CONTROL_API_ACCESS_TOKEN=replace-me
CHATWOOT_AGENT_BOT_ID=replace-me
CHATWOOT_AGENT_BOT_ACCESS_TOKEN=replace-me
CHATWOOT_PAUSE_MACRO_ID=replace-me
ALLOWED_WHATSAPP_JID=replace-me@s.whatsapp.net
CAPTURE_DIR=./data/captures
WEBHOOK_MAX_AGE_SECONDS=300
HERMES_SHADOW_ENABLED=false
HERMES_API_BASE_URL=https://hermes.example.com/v1
HERMES_API_KEY=replace-me
HERMES_MODEL_NAME=agente-comercial
SHADOW_DIR=./data/shadow
CHATWOOT_AUTOMATED_REPLIES_ENABLED=false
CHATWOOT_INBOUND_DEBOUNCE_SECONDS=30
CHATWOOT_REPLY_SPLITTER_ENABLED=false
CHATWOOT_REPLY_PART_DELAY_SECONDS=2
HERMES_REPLY_SPLITTER_PROVIDER=
HERMES_REPLY_SPLITTER_MODEL_NAME=
REPLY_DIR=./data/replies
# Hotmart webhook (cart abandonment recovery)
HOTMART_HOTTOK=replace-me
HOTMART_MAX_AGE_SECONDS=300
HOTMART_PURCHASE_WORKER_ENABLED=false
# Supabase (PostgREST API)
SUPABASE_BASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Resolution worker (deferred identity resolution)
RESOLUTION_WORKER_ENABLED=false
RESOLUTION_WORKER_POLL_INTERVAL=5.0
RESOLUTION_WORKER_BATCH_SIZE=10
FOLLOWUP_POLICY_KEY=cart-recovery-test
FOLLOWUP_POLICY_VERSION=1
# Lancemos pilot boundary. Keep disabled until the published scope, active
# version and cohort are provisioned durably in PostgreSQL.
LANCEMOS_PILOT_BOUNDARY_ENABLED=false
LANCEMOS_PILOT_SCOPE_KEY=
LANCEMOS_PILOT_SCOPE_VERSION=
LANCEMOS_PILOT_TENANT_KEY=
LANCEMOS_PILOT_CHANNEL_PROVIDER=
LANCEMOS_PILOT_CHANNEL_ACCOUNT_REF=
# Required when the pilot provider is WABA. Both approved templates must have
# exactly one body placeholder ({{1}}), filled with the authorized message.
WABA_FIRST_TOUCH_TEMPLATE_NAME=
WABA_FOLLOWUP_TEMPLATE_NAME=
WABA_TEMPLATE_LANGUAGE=
WABA_TEMPLATE_CATEGORY=MARKETING
# Durable dispatcher. Keep outbound disabled until the migration and
# allowlisted manual E2E environment are verified.
DURABLE_DISPATCHER_ENABLED=false
DURABLE_OUTBOUND_ENABLED=false
DURABLE_DISPATCHER_WORKER_ID=bridge-dispatcher-1
DURABLE_DISPATCHER_POLL_INTERVAL=5.0
DURABLE_DISPATCHER_BATCH_SIZE=10
# Human handoff is stop-first and remains default-off. Enable projection first;
# admission also requires outbound dispatcher and the durable pilot boundary.
HUMAN_HANDOFF_ADMISSION_ENABLED=false
HUMAN_HANDOFF_PROJECTION_ENABLED=false
HUMAN_HANDOFF_PROJECTION_WORKER_ID=handoff-projection-1
HUMAN_HANDOFF_PROJECTION_POLL_INTERVAL=5.0
HUMAN_HANDOFF_PROJECTION_BATCH_SIZE=10
HUMAN_HANDOFF_PROJECTION_LEASE_SECONDS=60
HUMAN_HANDOFF_PROJECTION_MAX_ATTEMPTS=8
HANDOFF_PROJECTION_POLICY_KEY=
HANDOFF_PROJECTION_POLICY_VERSION=
# Legacy compatibility only; pilot routing comes from the durable scope.
MESSAGING_CHANNEL=evolution
CHATWOOT_INBOX_ID=replace-me
