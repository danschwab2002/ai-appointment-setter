# Copiar como .env y reemplazar los valores.
CHATWOOT_WEBHOOK_SECRET=replace-me
CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_ACCOUNT_ID=replace-me
# Optional path to an exact non-secret per-ally JSON binding. Unset keeps the
# legacy Johanna binding for backwards compatibility.
COMMERCIAL_ALLY_CONFIG_PATH=
CHATWOOT_CONTROL_API_ACCESS_TOKEN=replace-me
CHATWOOT_AGENT_BOT_ID=replace-me
CHATWOOT_AGENT_BOT_ACCESS_TOKEN=replace-me
CHATWOOT_PAUSE_MACRO_ID=replace-me
CHATWOOT_HUMAN_PAUSE_ENABLED=false
# Durable opt-out is required by scoped inbound. Keep disabled until the
# server-owned macro and projection worker identity are configured.
CHATWOOT_DURABLE_OPT_OUT_ENABLED=false
# E-107: una baja nueva se confirma con una sola linea, sin vender, una vez
# por conversacion. Requiere la baja durable y las respuestas automaticas.
# El texto es opcional (default «Listo, no te escribimos más.»): una linea,
# sin link, cupon, precio ni pregunta, o el bridge no arranca.
OPT_OUT_CONFIRMATION_ENABLED=false
OPT_OUT_CONFIRMATION_TEXT=
CHATWOOT_RESUME_MACRO_ID=
CONVERSATION_RESUME_ENABLED=false
CONVERSATION_RESUME_QUIET_SECONDS=28800
CONVERSATION_RESUME_MAX=3
# Barredor de reactivacion: le manda una plantilla aprobada al lead que quedo
# esperando fuera de la ventana de servicio de 24 h, para que responda y el
# sistema de reanudacion (de arriba) pueda levantar la pausa.
CONVERSATION_REACTIVATION_ENABLED=false
WABA_REACTIVATION_TEMPLATE_NAME=
WABA_REACTIVATION_TEMPLATE_LANGUAGE=
CONVERSATION_REACTIVATION_INTERVAL_SECONDS=900
CONVERSATION_REACTIVATION_MIN_AGE_SECONDS=86400
CONVERSATION_REACTIVATION_MAX_AGE_SECONDS=2592000
CONVERSATION_REACTIVATION_MAX=1
CONVERSATION_REACTIVATION_MAX_SENDS_PER_SCAN=10
CONVERSATION_REACTIVATION_MAX_PAGES=5
# Seguimiento con cupon: una plantilla con boton al checkout (cupon ya cargado
# por offDiscount) para quien nos contesto, recibio nuestra respuesta y se quedo
# callado 24 h sin comprar. Nunca a quien no contesto. Uno por conversacion.
# Sin plantilla aprobada o sin cupon, el bridge no arranca con esto prendido.
CONVERSATION_FOLLOWUP_ENABLED=false
CONVERSATION_FOLLOWUP_TEMPLATE_NAME=
CONVERSATION_FOLLOWUP_TEMPLATE_LANGUAGE=
CONVERSATION_FOLLOWUP_COUPON_CODE=
CONVERSATION_FOLLOWUP_PRODUCT_NAME=
CONVERSATION_FOLLOWUP_INTERVAL_SECONDS=300
CONVERSATION_FOLLOWUP_MIN_AGE_SECONDS=86400
CONVERSATION_FOLLOWUP_MAX_AGE_SECONDS=259200
CONVERSATION_FOLLOWUP_MAX_SENDS_PER_SCAN=10
CONVERSATION_FOLLOWUP_MAX_PAGES=5
# Solo con manifiesto (1.5.0): HH-HH en la zona del manifiesto, obligatorio con
# el flag prendido; 00-24 es a cualquier hora. Sin manifiesto va vacio.
CONVERSATION_FOLLOWUP_SEND_HOURS=
# El modo de un solo telefono, para la prueba (E.164). Vacio: el alcance del
# entrante (todo el inbox con los remitentes por scope). Con manifiesto, un
# MIN_AGE menor a 86400 solo arranca con este telefono: es solo para la prueba.
CONVERSATION_FOLLOWUP_ONLY_PHONE=
CHATWOOT_OPT_OUT_MACRO_ID=
CHATWOOT_OPT_OUT_PROJECTION_WORKER_ID=
# Legacy/manual/test routes only; dedicated Johanna production routes derive identity durably.
ALLOWED_WHATSAPP_JID=
CAPTURE_DIR=./data/captures
WEBHOOK_MAX_AGE_SECONDS=300
HERMES_SHADOW_ENABLED=false
HERMES_API_BASE_URL=https://hermes.example.com/v1
HERMES_API_KEY=replace-me
HERMES_MODEL_NAME=agente-comercial
SHADOW_DIR=./data/shadow
CHATWOOT_AUTOMATED_REPLIES_ENABLED=false
CHATWOOT_INBOUND_DEBOUNCE_SECONDS=30
# M8.m1 (E-184): un entrante que llega a un minuto o menos de nuestra plantilla,
# sin ser un boton y con la forma de una respuesta automatica («gracias por
# comunicarte», «en breve», «horario de atencion»...), no le llega al agente.
CHATWOOT_BUSINESS_AUTO_REPLY_GUARD_ENABLED=false
# Periodically recover an open conversation only when its canonical latest
# public message is an unanswered inbound. Default-off until a controlled E2E.
CHATWOOT_STALLED_MONITOR_ENABLED=false
CHATWOOT_STALLED_MONITOR_INTERVAL_SECONDS=60
CHATWOOT_STALLED_AFTER_SECONDS=120
CHATWOOT_STALLED_MAX_AGE_SECONDS=86400
CHATWOOT_STALLED_MAX_PAGES=5
CHATWOOT_STALLED_RECOVERY_COOLDOWN_SECONDS=300
CHATWOOT_STALLED_MAX_RECOVERY_ADMISSIONS=3
# Admit scoped inbound into the canonical commercial root. This cut remains
# draft_only/shadow and terminates before Hermes or any reply.
CHATWOOT_CUT_B_ADMISSION_ENABLED=false
CHATWOOT_CUT_B_SCOPE_KEY=
CHATWOOT_CUT_B_SCOPE_VERSION=
# Controlled allowlisted inbound only. Requires admission, Hermes and replies.
CHATWOOT_CUT_B_AGENT_ENABLED=false
# Deterministic checkout transport. The bridge appends only the first free
# allowlisted field and never asks the model to construct or rewrite the URL.
PAYMENT_LINK_ENABLED=false
PAYMENT_LINK_TRACKING_FIELDS=src,xcod
PAYMENT_LINK_TRACKING_PREFIX=hermes-
PAYMENT_LINK_MAX_AGE_SECONDS=604800
# Optional approved WhatsApp template whose URL button carries the link
# (docs/contracts/johanna-payment-link-v2.md). Empty keeps the written link.
PAYMENT_LINK_TEMPLATE_NAME=
PAYMENT_LINK_TEMPLATE_LANGUAGE=
# Plan one deferred 10% offer only after canonical inbound. This does not send it.
CHATWOOT_POST_INBOUND_DISCOUNT_PLANNING_ENABLED=false
COMMERCIAL_ALLY_DISCOUNT_POLICY_KEY=
COMMERCIAL_ALLY_DISCOUNT_POLICY_VERSION=
CHATWOOT_SCOPED_INBOUND_SENDERS_ENABLED=false
CHATWOOT_REPLY_SPLITTER_ENABLED=false
CHATWOOT_REPLY_PART_DELAY_SECONDS=2
HERMES_REPLY_SPLITTER_PROVIDER=
HERMES_REPLY_SPLITTER_MODEL_NAME=
REPLY_DIR=./data/replies
# Hotmart webhook (cart abandonment recovery)
HOTMART_HOTTOK=replace-me
HOTMART_MAX_AGE_SECONDS=300
# Optional central Slack connector. Configure both values or neither. Johanna
# and ATT1 deployments must receive different internal bearer tokens.
SLACK_CONNECTOR_PROJECTION_ENABLED=false
SLACK_CONNECTOR_BASE_URL=
SLACK_CONNECTOR_BEARER_TOKEN=
SLACK_CONNECTOR_WORKER_ID=
SLACK_CONNECTOR_POLL_INTERVAL_SECONDS=5
SLACK_CONNECTOR_BATCH_SIZE=1
SLACK_CONNECTOR_LEASE_SECONDS=60
# AI identity pre-resolution runs inside the bridge. Keep both this worker and
# Slack projection disabled until migrations 20260916000100 and 20260917000100
# are applied. V3 pins the exact JSON enums and types after V2 exposed an
# underspecified decision token; V1/V2 remain supported only for rollback.
# When Slack projection is enabled, pre-resolution is mandatory and starts first.
CORRELATION_PRERESOLUTION_ENABLED=false
CORRELATION_PRERESOLUTION_MODEL_NAME=agente-comercial
CORRELATION_PRERESOLUTION_PROMPT_VERSION=correlation-preresolution-v3
CORRELATION_PRERESOLUTION_WORKER_ID=
CORRELATION_PRERESOLUTION_POLL_INTERVAL=5
# Portable binding-authorized PURCHASE_APPROVED admission/correlation/stop only.
# No worker, scheduling, command, message, delivery, or outbound effect.
PORTABLE_HOTMART_PURCHASE_STOP_ENABLED=false
# Portable binding-scoped recovery admission. Does not bypass downstream gates.
PORTABLE_HOTMART_RECOVERY_ENABLED=false
PORTABLE_HOTMART_PAYMENT_FAILURE_ENABLED=false
# Modo «solo guardar» (E-057): el carrito y el pago rechazado de un flujo
# apagado se guardan con la admision portable y quedan ignored /
# listen_only_capture, asi ningun worker los toma. No manda nada y no se ata a
# [flujos]. Exige el manifiesto, PORTABLE_HOTMART_PURCHASE_STOP_ENABLED y
# HOTMART_HOTTOK. Con el flag del flujo prendido, manda el flujo. Requiere la
# migracion 20261024000100.
PORTABLE_HOTMART_CAPTURE_ENABLED=false
# Primer contacto portable tras el formulario de la landing: la admision del
# formulario planifica un unico primer contacto demorado y el dispatcher lo
# manda con la plantilla de [plantillas.precheckout]. Solo con manifiesto de
# instancia. Prendido exige flujos.precheckout, una entrada del formulario
# (LEAD_PRECHECKOUT_ENABLED o GHL_PRECHECKOUT_ADAPTER_ENABLED),
# LANCEMOS_PILOT_BOUNDARY_ENABLED, DURABLE_DISPATCHER_ENABLED,
# DURABLE_APPROVED_TEMPLATE_DIRECT_ENABLED, el scope del piloto de este flujo
# (LANCEMOS_PILOT_PRECHECKOUT_SCOPE_*), WABA_PRECHECKOUT_TEMPLATE_NAME y lo que
# lo frena: PORTABLE_HOTMART_PURCHASE_STOP_ENABLED con HOTMART_HOTTOK, y
# CHATWOOT_SCOPED_INBOUND_SENDERS_ENABLED (opt-out y derivacion). Requiere las
# migraciones 20261001000100 y 20261001000200.
PORTABLE_PRECHECKOUT_FIRST_CONTACT_ENABLED=false
# Primer contacto portable tras la ficha de pago (C1, OXXO y parecidos): el
# webhook admite y cruza la ficha con la intencion
# (admit_portable_hotmart_payment_slip_v2), el worker la filtra por la tabla
# [[ficha.medios]] del manifiesto (lo que no tiene fila habilitada queda
# ignored con su motivo) y la planifica contra su propio scope y su propia
# politica, y el dispatcher manda [plantillas.ficha] con la ficha en el boton.
# Una ficha ya vencida al componer no se manda (payment_slip_expired). Solo con
# manifiesto de instancia. Prendido exige flujos.ficha, el evento
# ficha_impresa, una fila habilitada en [[ficha.medios]], HOTMART_HOTTOK,
# RESOLUTION_WORKER_ENABLED, LANCEMOS_PILOT_BOUNDARY_ENABLED,
# DURABLE_DISPATCHER_ENABLED, DURABLE_APPROVED_TEMPLATE_DIRECT_ENABLED,
# LANCEMOS_PILOT_PAYMENT_SLIP_SCOPE_*, PAYMENT_SLIP_FOLLOWUP_POLICY_*,
# WABA_PAYMENT_SLIP_TEMPLATE_NAME y _CATEGORY, y lo que lo frena:
# PORTABLE_HOTMART_PURCHASE_STOP_ENABLED y CHATWOOT_SCOPED_INBOUND_SENDERS_ENABLED.
# Apagado, la ficha se descarta como hasta la 1.10. Requiere la migracion
# 20261019000100.
PORTABLE_HOTMART_PAYMENT_SLIP_ENABLED=false
# B1 del pago rechazado: un PURCHASE_CANCELED que es un rechazo planifica un
# primer toque a la gracia de su propia politica contada desde el ULTIMO
# rechazo, con la primera variante que corresponde (cupon de otro caso, dos
# rechazos, saldo con su cupon de 24 h, banco) y nuestro link de recuperacion
# en el boton. Si el cupon o el link fallan sale WABA_PAYMENT_FAILURE_TEMPLATE_NAME.
# Prendido exige PORTABLE_HOTMART_PAYMENT_FAILURE_ENABLED,
# LANCEMOS_PILOT_BOUNDARY_ENABLED, DURABLE_APPROVED_TEMPLATE_DIRECT_ENABLED,
# RECOVERY_COUPON_WORKER_ENABLED, LANCEMOS_PILOT_PAYMENT_FAILURE_SCOPE_*,
# PAYMENT_FAILURE_FOLLOWUP_POLICY_* (claves propias, distintas de las de los
# otros caminos) y las cuatro WABA_PAYMENT_FAILURE_TEMPLATE_* de abajo. Apagado
# no se lee nada de eso y el pago fallido sigue con el scope del carrito.
# Requiere la migracion 20261019000200; el scope se arma ANTES de prenderlo
# (si no, cada rechazo se rechaza con pilot_runtime_not_armed). Contrato:
# docs/contracts/portable-payment-failure-variants-v1.md.
PAYMENT_FAILURE_VARIANTS_ENABLED=false
# El scope y la politica propios del pago rechazado SIN las variantes (E-157):
# sale WABA_PAYMENT_FAILURE_TEMPLATE_NAME, con la gracia de
# PAYMENT_FAILURE_FOLLOWUP_POLICY_* y los topes de
# LANCEMOS_PILOT_PAYMENT_FAILURE_SCOPE_*. El carrito no cambia. Prendido exige
# esos cuatro, PORTABLE_HOTMART_PAYMENT_FAILURE_ENABLED,
# LANCEMOS_PILOT_BOUNDARY_ENABLED y WABA_PAYMENT_FAILURE_TEMPLATE_NAME; no exige
# el modo directo, el worker del cupon ni las cuatro plantillas. El scope se
# arma ANTES de prenderlo. Con PAYMENT_FAILURE_VARIANTS_ENABLED tambien, manda B1.
PAYMENT_FAILURE_OWN_POLICY_ENABLED=false
LANCEMOS_PILOT_PAYMENT_FAILURE_SCOPE_KEY=
LANCEMOS_PILOT_PAYMENT_FAILURE_SCOPE_VERSION=
PAYMENT_FAILURE_FOLLOWUP_POLICY_KEY=
PAYMENT_FAILURE_FOLLOWUP_POLICY_VERSION=
WABA_PAYMENT_FAILURE_TEMPLATE_COUPON=
WABA_PAYMENT_FAILURE_TEMPLATE_TWO_REFUSALS=
WABA_PAYMENT_FAILURE_TEMPLATE_INSUFFICIENT_FUNDS=
WABA_PAYMENT_FAILURE_TEMPLATE_DECLINED=
# El seguimiento del pago rechazado, 24 h despues de B1 a quien no contesto:
# B2 (SECOND_TOUCH) si B1 salio sin cupon, Z (LAST_TOUCH) si salio con cupon.
# Los dos llevan el cupon 2 del caso y nuestro link; sin el cupon valid a
# tiempo, el seguimiento cierra sin mensaje. Prendido exige
# PAYMENT_FAILURE_VARIANTS_ENABLED, RECOVERY_COUPON_WORKER_ENABLED y las dos
# plantillas (distintas). Apagado, el paso payment_failure_followup de la
# politica cierra sin mensaje. Requiere la migracion 20261019000700 y una
# politica del pago rechazado con ese paso. Contrato:
# docs/contracts/portable-payment-failure-followup-v1.md.
PAYMENT_FAILURE_FOLLOWUP_ENABLED=false
WABA_PAYMENT_FAILURE_TEMPLATE_SECOND_TOUCH=
WABA_PAYMENT_FAILURE_TEMPLATE_LAST_TOUCH=
HOTMART_PURCHASE_WORKER_ENABLED=false
# DB-only expiration worker. Delay comes from the producer's durable policy.
HOTMART_ABANDONMENT_TIMER_WORKER_ENABLED=false
HOTMART_ABANDONMENT_TIMER_POLL_INTERVAL=5.0
HOTMART_ABANDONMENT_TIMER_BATCH_SIZE=10
# Delayed authorized precheckout first touch; requires the timer worker and WABA.
PRECHECKOUT_DELAYED_FIRST_TOUCH_ENABLED=false
# Final request-start/POST gate for the pending precheckout template.
PRECHECKOUT_DELAYED_OUTBOUND_ENABLED=false
# Provisional pre-checkout receiver: controlled JID only; never authorizes outbound.
PRECHECKOUT_FORM_ENABLED=false
PRECHECKOUT_FORM_TOKEN=
PRECHECKOUT_TEST_MODE_ENABLED=false
PRECHECKOUT_TEST_PHONE_E164=
PRECHECKOUT_MAX_AGE_SECONDS=300
# Authenticated server-side Lancemos relay. Admission only; no outbound authority.
LEAD_PRECHECKOUT_ENABLED=false
LEAD_PRECHECKOUT_SECRET=
LEAD_PRECHECKOUT_MAX_AGE_SECONDS=300
LEAD_PRECHECKOUT_SITE=psicologajohanna
LEAD_PRECHECKOUT_LANDING_ID=ads-a
LEAD_PRECHECKOUT_OFFER_CODE=bxjge6zq
# Adaptador del formulario de GHL a lead.precheckout. Admision solamente, sin
# autoridad de salida. Prendido exige manifiesto de instancia, "intencion" en
# eventos y [adaptadores.ghl]. El token (32 caracteres o mas, distinto de todo
# otro secreto del bridge) viaja en el header X-Setter-Adapter-Token o en
# customData.setter_token, nunca en la URL.
# Con [adaptadores.ghl] en el manifiesto (prendido o no este flag), sin la
# aceptacion escrita del riesgo (riesgo_aceptado_por, riesgo_aceptado_el y
# riesgo_contrato en esa seccion) el bridge no arranca con flujos.precheckout
# ni flujos.pago_fallido en true, ni con LANCEMOS_PILOT_BOUNDARY_ENABLED y un
# scope del piloto de audiencia consented_intent o consented_intent_in_cohort
# (lo lee de la base al arrancar y en /ready; requiere la migracion
# 20261001000300).
# docs/contracts/ghl-precheckout-adapter-v1.md
GHL_PRECHECKOUT_ADAPTER_ENABLED=false
GHL_PRECHECKOUT_ADAPTER_TOKEN=
# Primer nombre en {{1}} de toda plantilla de primer contacto de Johanna.
# En una instancia con manifiesto lo usa solo el dispatcher con
# DURABLE_APPROVED_TEMPLATE_DIRECT_ENABLED=true.
# GREETING sola ya saluda por la primera palabra con las mayusculas arregladas.
# INFERENCE (requiere GREETING, Hermes y Supabase con la migracion
# 20260928000300) le pide el nombre al modelo al admitir el formulario; el
# envio usa esa respuesta solo si el modelo dijo que estaba seguro.
LEAD_FIRST_NAME_GREETING_ENABLED=false
LEAD_FIRST_NAME_INFERENCE_ENABLED=false
LEAD_FIRST_NAME_MODEL_NAME=agente-comercial
# Transcripcion de audios entrantes de WhatsApp por OpenRouter
# (/api/v1/audio/transcriptions). Los modelos se prueban en orden: el segundo es
# el respaldo. Si fallan todos, la conversacion se deriva a una persona
# (requiere HUMAN_HANDOFF_ADMISSION_ENABLED y la admision de Corte B).
CHATWOOT_AUDIO_TRANSCRIPTION_ENABLED=false
OPENROUTER_API_KEY=
AUDIO_TRANSCRIPTION_MODELS=openai/whisper-large-v3-turbo,microsoft/mai-transcribe-2
AUDIO_TRANSCRIPTION_CACHE_DIR=./data/audio-transcriptions
# One-shot WABA first touch for the exact test JID; no scheduler or follow-ups.
PRECHECKOUT_FIRST_TOUCH_ENABLED=false
PRECHECKOUT_FIRST_TOUCH_TOKEN=
# Controlled V1.1 Johanna E2E. Operator-only, one global message, no follow-ups.
JOHANNA_ABANDONMENT_ONE_SHOT_ENABLED=false
JOHANNA_ABANDONMENT_ONE_SHOT_TOKEN=
JOHANNA_ABANDONMENT_HOTMART_AUTO_ENABLED=false
JOHANNA_PAYMENT_FAILURE_HOTMART_ENABLED=false
JOHANNA_PAYMENT_FAILURE_OUTBOUND_ENABLED=false
# Supabase (PostgREST API)
SUPABASE_BASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Read-only operator projection for the Client Copilot. Keep disabled until
# the SQL RPC, bridge bearer and private profile credentials are deployed.
OPERATOR_CORRELATION_READ_ENABLED=false
OPERATOR_CORRELATION_READ_TOKEN=
OPERATOR_CORRELATION_TENANT_REF=
OPERATOR_CORRELATION_FUNNEL_REF=
# Supervised manual resolution. Uses a distinct bearer and a server-owned,
# non-PII operator slug. Enabling this does not enable workers or outbound.
OPERATOR_CORRELATION_WRITE_ENABLED=false
OPERATOR_CORRELATION_WRITE_TOKEN=
OPERATOR_CORRELATION_ACTOR_REF=
OPERATOR_CORRELATION_ACTOR_PREFIX=
# Read-only routes of the Automation Expert (automation-expert-read-v1). Needs
# the instance manifest and its own token: at least 32 characters, different
# from every other secret of the bridge. Keep disabled until the migration and
# the automation-expert profile are deployed.
AUTOMATION_EXPERT_READ_ENABLED=false
AUTOMATION_EXPERT_READ_TOKEN=
# Change routes of the Automation Expert (flow-change-cycle-v1): the agent
# proposes and validates a flow change, never approves or publishes it. Needs
# the read routes on, its own token (32+ characters, different from every other
# secret) and the JWT of the database role automation_expert_change (never the
# service_role key). Keep disabled until 20261021000100 is applied.
AUTOMATION_EXPERT_CHANGE_ENABLED=false
AUTOMATION_EXPERT_CHANGE_TOKEN=
AUTOMATION_EXPERT_CHANGE_DB_KEY=
# The approval page (flow-change-cycle-v1 1.9.0, A' PR 3a): /flow-approval/ with
# "Sign in with Slack" on the public origin of this bridge (https, no path). It
# only shows proposals for now. Needs the Slack app of the Automation Expert with
# the openid user scope and the redirect URL <origin>/flow-approval/auth/slack/callback,
# the workspace, the approvers (Slack user IDs, comma separated), a session
# secret (32+ characters) and the JWT of the database role flow_change_approver,
# each different from every other secret. Keep disabled until 20261028000100 is
# applied.
FLOW_APPROVAL_ENABLED=false
FLOW_APPROVAL_BASE_URL=
FLOW_APPROVAL_SLACK_TEAM_ID=
FLOW_APPROVAL_SLACK_APPROVERS=
FLOW_APPROVAL_SLACK_CLIENT_ID=
FLOW_APPROVAL_SLACK_CLIENT_SECRET=
FLOW_APPROVAL_SESSION_SECRET=
FLOW_CHANGE_APPROVER_DB_KEY=
# The flow engine bridge (flow-engine-v1, section 8): the cart with its route
# in motor is admitted by the engine, an engine step goes out with the template
# of its pinned version, /ready publishes the routes, and a divergence raises
# MOT-001. Needs the instance manifest, the pilot boundary, the resolution
# worker, the dispatcher in direct template mode, A1 with its coupon and A2/Z.
# Off, the bridge reads nothing of the engine. Keep disabled until
# 20261022000200 is applied.
FLOW_ENGINE_ENABLED=false
# flow-engine-v2 (native flows): with the flag, the bridge also reads the
# native flows of the instance and the engine rejections (MOT-002) every 60 s.
# A purchase with a native flow on or in its cohort goes to the native
# admission after it is applied. The step "etiquetar: cliente" adds the label
# cliente through a Chatwoot macro that ONLY adds that label (never the pause,
# resume or opt-out macro); without it the step leaves only the private note.
CHATWOOT_CLIENT_LABEL_MACRO_ID=
# flow-engine-v2 section 24 (E-252): the form of the main product goes to
# admit_and_route_portable_lead_precheckout_v1, which decides in the base if a
# native "intencion" flow takes it or the legacy plans it (with
# PORTABLE_PRECHECKOUT_FIRST_CONTACT_ENABLED) as today. Needs FLOW_ENGINE_ENABLED,
# an entry for the form, the purchase stop with its hottok and the scoped
# inbound. Off (ATT1), the form goes exactly as today. Keep disabled until
# 20261101000100 is applied.
FLOW_ENGINE_NATIVE_INTENT_ENABLED=false
# Resolution worker (deferred identity resolution)
RESOLUTION_WORKER_ENABLED=false
RESOLUTION_WORKER_POLL_INTERVAL=5.0
RESOLUTION_WORKER_BATCH_SIZE=10
FOLLOWUP_POLICY_KEY=cart-recovery-test
FOLLOWUP_POLICY_VERSION=1
# Lancemos pilot boundary. Keep disabled until the published scope, active
# version and cohort are provisioned durably in PostgreSQL.
LANCEMOS_PILOT_BOUNDARY_ENABLED=false
LANCEMOS_PILOT_SCOPE_KEY=
LANCEMOS_PILOT_SCOPE_VERSION=
LANCEMOS_PILOT_TENANT_KEY=
LANCEMOS_PILOT_CHANNEL_PROVIDER=
LANCEMOS_PILOT_CHANNEL_ACCOUNT_REF=
# Instance manifest only: the published pilot scope of the first contact after
# the landing form (source landing, event PRECHECKOUT_FORM_SUBMITTED, never
# manual_cohort). It is another scope than LANCEMOS_PILOT_SCOPE_KEY and shares
# its tenant, provider and channel account. Required by
# PORTABLE_PRECHECKOUT_FIRST_CONTACT_ENABLED; empty otherwise.
LANCEMOS_PILOT_PRECHECKOUT_SCOPE_KEY=
LANCEMOS_PILOT_PRECHECKOUT_SCOPE_VERSION=
# Instance manifest only: the published pilot scope of the first contact after
# a payment slip (source hotmart, event PURCHASE_BILLET_PRINTED; in ATT1
# att1-ficha). Another scope than LANCEMOS_PILOT_SCOPE_KEY and the precheckout
# one, with the same tenant, provider and channel account. Its policy is its
# own too (in ATT1 att1-ficha-un-toque: 60 minutes of grace, one day of life,
# one step payment_slip_first_contact). Required by
# PORTABLE_HOTMART_PAYMENT_SLIP_ENABLED; empty otherwise.
LANCEMOS_PILOT_PAYMENT_SLIP_SCOPE_KEY=
LANCEMOS_PILOT_PAYMENT_SLIP_SCOPE_VERSION=
PAYMENT_SLIP_FOLLOWUP_POLICY_KEY=
PAYMENT_SLIP_FOLLOWUP_POLICY_VERSION=
# Required when the pilot provider is WABA. The first-touch template uses
# {{1}} = buyer name and {{2}} = product/offer. Follow-up is optional; leaving
# it empty blocks every follow-up before the Chatwoot message POST.
WABA_FIRST_TOUCH_TEMPLATE_NAME=
WABA_PAYMENT_FAILURE_TEMPLATE_NAME=att1_compra_fallida_01
# Instance manifest only: the approved template of the first contact after the
# landing form. It must be plantillas.precheckout.nombre. There is no fallback:
# without it that first contact is not sent, never with the cart template.
WABA_PRECHECKOUT_TEMPLATE_NAME=
WABA_FOLLOWUP_TEMPLATE_NAME=
WABA_TEMPLATE_LANGUAGE=
WABA_TEMPLATE_CATEGORY=MARKETING
# Instance manifest only: the Meta category of the payment failure template
# when it differs from WABA_TEMPLATE_CATEGORY (MARKETING or UTILITY). Empty
# keeps WABA_TEMPLATE_CATEGORY for every template. The direct mode checks each
# template against its own category.
WABA_PAYMENT_FAILURE_TEMPLATE_CATEGORY=
# Instance manifest only: the approved template of the first contact after a
# payment slip and its Meta category (MARKETING or UTILITY; written down, no
# default). The name must be plantillas.ficha.nombre. There is no fallback:
# without it a slip is never sent, never with the cart template.
WABA_PAYMENT_SLIP_TEMPLATE_NAME=
WABA_PAYMENT_SLIP_TEMPLATE_CATEGORY=
# Instance manifest only: the reminders of the slip's due date (C2 the day
# before, C3 the due date; payment_slip_reminders). Each one is optional and
# goes in pairs: the name must be plantillas.ficha_vence_manana.nombre (or
# ficha_vence_hoy) and the category is written down. Without them the policy
# step closes without a message (first_touch_template_not_configured). They
# only go out with PORTABLE_HOTMART_PAYMENT_SLIP_ENABLED, a slip policy with
# the steps payment_slip_due_eve and payment_slip_due_day, and the migration
# 20261019000400.
WABA_PAYMENT_SLIP_DUE_EVE_TEMPLATE_NAME=
WABA_PAYMENT_SLIP_DUE_EVE_TEMPLATE_CATEGORY=
WABA_PAYMENT_SLIP_DUE_DAY_TEMPLATE_NAME=
WABA_PAYMENT_SLIP_DUE_DAY_TEMPLATE_CATEGORY=
# Durable dispatcher. Keep outbound disabled until the migration and
# allowlisted manual E2E environment are verified.
DURABLE_DISPATCHER_ENABLED=false
DURABLE_OUTBOUND_ENABLED=false
# Instance manifest only: the dispatcher sends the approved template body read
# from the Chatwoot catalog and never asks Hermes for a draft. With a manifest,
# META_FINAL_EFFECT_ENABLED=true plus DURABLE_OUTBOUND_ENABLED=true requires it.
# docs/contracts/approved-template-direct-dispatch-v1.md
DURABLE_APPROVED_TEMPLATE_DIRECT_ENABLED=false
# The only deliberate pre-production cut: validate and record the complete
# outbound effect, but do not call the Meta transport while false.
META_FINAL_EFFECT_ENABLED=false
META_FINAL_EFFECT_EVIDENCE_DIR=./data/meta-final-effect-gate
DURABLE_DISPATCHER_WORKER_ID=bridge-dispatcher-1
DURABLE_DISPATCHER_POLL_INTERVAL=5.0
DURABLE_DISPATCHER_BATCH_SIZE=10
# Human handoff is stop-first and remains default-off. Enable projection first;
# admission requires either Cut B inbound or outbound dispatcher + pilot boundary.
HUMAN_HANDOFF_ADMISSION_ENABLED=false
# F-034: al derivar, la persona recibe un aviso corto y fijo (nombra al
# equipo, sin plazo ni nombre) antes de la pausa. Requiere la admision.
HANDOFF_NOTICE_ENABLED=false
# F-034, D8: al derivar, una nota privada con el ultimo link que le mandamos
# a la persona (y su cupon, si vino del carrito). Requiere la admision.
HANDOFF_LINK_NOTE_ENABLED=false
# E-100: al comprar, la conversacion del comprador queda pausada para el agente
# (automation_paused), asignada al team de [chatwoot].equipo_derivacion y con
# una nota privada. Requiere el manifiesto, el worker y el de compras.
PURCHASE_AGENT_PAUSE_ENABLED=false
# E-190: con un flujo nativo de la compra (la bienvenida), la misma pausa va
# despues de que Chatwoot acepta la bienvenida, en esa conversacion. Apagado,
# quien recibe la bienvenida sigue atendido por el agente. Requiere
# PURCHASE_AGENT_PAUSE_ENABLED, FLOW_ENGINE_ENABLED y el despachador.
PURCHASE_AGENT_PAUSE_AFTER_NATIVE_WELCOME_ENABLED=false
HUMAN_HANDOFF_PROJECTION_ENABLED=false
HUMAN_HANDOFF_PROJECTION_WORKER_ID=handoff-projection-1
HUMAN_HANDOFF_PROJECTION_POLL_INTERVAL=5.0
HUMAN_HANDOFF_PROJECTION_BATCH_SIZE=10
HUMAN_HANDOFF_PROJECTION_LEASE_SECONDS=60
HUMAN_HANDOFF_PROJECTION_MAX_ATTEMPTS=8
HANDOFF_PROJECTION_POLICY_KEY=
HANDOFF_PROJECTION_POLICY_VERSION=
# Legacy compatibility only; pilot routing comes from the durable scope.
MESSAGING_CHANNEL=evolution
CHATWOOT_INBOX_ID=replace-me
