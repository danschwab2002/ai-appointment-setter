# Start inert, then activate in the runbook order.
SLACK_INGRESS_ENABLED=false
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_INTERACTIONS_ENABLED=false
SLACK_CORRELATION_BACKFILL_ENABLED=false
SLACK_CONNECTIVITY_CHECK_ENABLED=false

# Secrets: configure only in the EasyPanel service environment.
SLACK_BOT_TOKEN=replace-with-bot-token
SLACK_TENANT_TOKENS_JSON={"johanna":"replace-with-32-plus-random-characters"}

# Server-owned Slack routing.
SLACK_TEAM_ID=replace-with-workspace-team-id
# C0C0YEACVT2 is exclusively Johanna. Add ATT1 only after its separate channel exists.
SLACK_TENANT_CHANNELS_JSON={"johanna":"C0C0YEACVT2"}
SLACK_STORAGE_PATH=/app/data/slack-connector.sqlite3
SLACK_WORKER_ID=slack-worker-1
SLACK_POLL_INTERVAL_SECONDS=1
SLACK_MAX_NONTERMINAL_NOTIFICATIONS=10000
SLACK_STORAGE_PREFLIGHT_ENABLED=true

# Durable outbound authorization. Start inactive. First send uses a new
# one_shot generation; continuous requires operator verification and a newer generation.
SLACK_ACTIVATION_MODE=inactive
SLACK_ACTIVATION_GENERATION=0

# Separate from both producer bearers; configure only in the secret manager.
SLACK_OPERATOR_BEARER_TOKEN=replace-with-distinct-32-plus-random-characters

# Interactive resolution stays off until Slack Interactivity and the scoped
# bridge backend are configured. Never put these secret values in source control.
SLACK_SIGNING_SECRET=replace-with-slack-signing-secret
SLACK_TENANT_OPERATOR_USER_IDS_JSON={"johanna":["U0123456789"]}
SLACK_TENANT_OPERATOR_BACKENDS_JSON={"johanna":{"base_url":"https://infra-appointment-bridge.example.test","read_token":"replace-with-distinct-read-token","write_token":"replace-with-distinct-write-token"}}
