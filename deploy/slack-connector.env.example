# Start inert, then activate in the runbook order.
SLACK_INGRESS_ENABLED=false
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_INTERACTIONS_ENABLED=false
SLACK_CONNECTIVITY_CHECK_ENABLED=false

# Secrets: configure only in the EasyPanel service environment.
SLACK_BOT_TOKEN=replace-with-bot-token
SLACK_TENANT_TOKENS_JSON={"johanna":"replace-with-32-plus-random-characters","att1":"replace-with-different-32-plus-random-characters"}

# Server-owned Slack routing.
SLACK_TEAM_ID=replace-with-workspace-team-id
SLACK_CHANNEL_ID=C0C0YEACVT2
SLACK_STORAGE_PATH=/app/data/slack-connector.sqlite3
SLACK_WORKER_ID=slack-worker-1
SLACK_POLL_INTERVAL_SECONDS=1
SLACK_MAX_NONTERMINAL_NOTIFICATIONS=10000
